# ==========================================================================
#  Coastal AI Summit & SME Trade Fair — what git must never carry
#
#  The rule: code and design are versioned; the site's data is not. Everything
#  below either identifies the installation, holds live client records, or is
#  regenerated automatically on the server.
# ==========================================================================

# ---------------------------------------------------------------- secrets
# SMTP password and any other credential. Never commit this file.
storage/env.php
env.php
*.env
.env

# ------------------------------------------------------------- the database
# Holds every setting, booking, payment and the staff password hashes.
storage/*.db
storage/*.db-shm
storage/*.db-wal
storage/*.sqlite
storage/*.sqlite3

# The file that records the database's deliberately unguessable name.
# Publishing it would undo that protection.
storage/config.php

# Database dumps. site-data.sql carries every row the live site holds,
# including the staff password hashes — it is for importing, not for sharing.
database/site-data.sql
database/*-data.sql
*.sql.gz
*.dump

# Per-installation state, written by the installer and the migration.
storage/installed.lock
storage/schema-version.lock

# ------------------------------------------------------- client information
# Proof-of-payment files people upload, and the tickets and receipts
# generated for them. Personal data — keep it on the server only.
storage/proofs/*
storage/tickets/*
storage/receipts/*
storage/tmp/*

# ...but do keep the rules that stop the web server serving those folders,
# so a fresh deployment is protected from the very first request.
!storage/proofs/.htaccess
!storage/proofs/web.config
!storage/proofs/index.html
!storage/tickets/.htaccess
!storage/tickets/web.config
!storage/tickets/index.html
!storage/receipts/.htaccess
!storage/receipts/web.config
!storage/receipts/index.html
!storage/tmp/.htaccess
!storage/tmp/web.config
!storage/tmp/index.html

# ------------------------------------------------------------ uploaded media
# Anything added through the control panel belongs to the live site, not here.
uploads/*
!uploads/.htaccess
!uploads/web.config

# Resized copies of site images. Rebuilt automatically on the next page view.
uploads/cache/

# ----------------------------------------------------- editors and operating
# systems
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
._*
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-*

# ------------------------------------------------------------------ scratch
*.log
*.bak
*.orig
*.tmp
_*.php
